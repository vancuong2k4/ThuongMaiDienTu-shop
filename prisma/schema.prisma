// ============================================================
// THUYNGA SHOP – Prisma Schema
// Database: PostgreSQL 16
// Cập nhật: 2026-10-23
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING        // Chờ xác nhận
  CONFIRMED      // Đã xác nhận
  PROCESSING     // Đang xử lý
  SHIPPING       // Đang giao
  DELIVERED      // Đã giao
  CANCELLED      // Đã hủy
  REFUNDED       // Đã hoàn tiền
}

enum PaymentMethod {
  COD
  VIETQR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VoucherType {
  PERCENTAGE   // Giảm theo %
  FIXED        // Giảm số tiền cố định
  FREE_SHIP    // Miễn phí vận chuyển
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FEATURED
}

enum MembershipTier {
  BRONZE      // Đồng (Mặc định khi đăng ký)
  SILVER      // Bạc (Chi tiêu từ 3.000.000₫)
  GOLD        // Vàng (Chi tiêu từ 10.000.000₫)
  DIAMOND     // Kim Cương (Chi tiêu từ 25.000.000₫)
}

enum LoyaltyType {
  EARN_ORDER      // Tích điểm từ đơn hàng giao thành công
  REDEEM_ORDER    // Trừ điểm giảm giá trực tiếp lúc thanh toán
  REDEEM_VOUCHER  // Đổi điểm lấy mã giảm giá độc quyền
  ADMIN_ADJUST    // Admin điều chỉnh (thưởng/bù điểm)
  SIGNUP_BONUS    // Điểm thưởng khi đăng ký tài khoản mới
  EARN_REFERRAL   // Thưởng điểm từ chương trình Mời Bạn Nhận Quà (+500 pts)
  EARN_REVIEW     // Thưởng điểm khi đánh giá sản phẩm & UGC (+50 - +150 pts)
}

enum NotificationType {
  ORDER_STATUS    // Cập nhật trạng thái đơn hàng (Xác nhận, Đang giao, Đã giao, Hủy)
  PROMOTION       // Ưu đãi Flash Sale, Voucher mới
  LOYALTY_TIER    // Thăng hạng VIP, Quà tặng sinh nhật, Hoàn điểm thưởng
  SYSTEM          // Thông báo hệ thống
}

enum ReferralStatus {
  PENDING       // Người được mời đã đăng ký, chưa có đơn hàng đầu tiên
  QUALIFIED     // Đã đặt đơn đầu tiên, đang chờ giao hàng
  REWARDED      // Đơn đầu tiên giao thành công, đã thưởng điểm cho người mời
  EXPIRED       // Hết hạn hoặc đơn hàng bị hủy
}

enum SubscriptionFrequency {
  EVERY_2_WEEKS   // Mỗi 2 tuần
  EVERY_1_MONTH   // Mỗi 1 tháng (Mặc định phổ biến)
  EVERY_2_MONTHS  // Mỗi 2 tháng
  EVERY_3_MONTHS  // Mỗi 3 tháng
}

enum SubscriptionStatus {
  ACTIVE          // Đang hoạt động, chờ đến kỳ giao tiếp theo
  PAUSED          // Tạm dừng theo yêu cầu của khách hàng
  CANCELLED       // Đã hủy gói định kỳ
  EXPIRED         // Hết hiệu lực
}

enum ShipmentStatus {
  DEPARTED            // Đã cất cánh từ Úc (Sydney/Melbourne)
  IN_TRANSIT          // Đang trên khoang hàng không
  CUSTOMS_CLEARED     // Đã hạ cánh & hoàn tất thông quan hải quan Nội Bài
  IN_WAREHOUSE        // Đã nhập kho mát tiêu chuẩn tại THUYNGA Shop
}

enum AirlineCarrier {
  VIETNAM_AIRLINES_CARGO   // Vietnam Airlines Cargo (VN)
  QANTAS_FREIGHT           // Qantas Freight (QF)
  EMIRATES_SKYCARGO        // Emirates SkyCargo (EK)
  SINGAPORE_AIRLINES_CARGO // Singapore Airlines Cargo (SQ)
}

enum HealthTargetGroup {
  BABY_KIDS        // Bé sơ sinh & Trẻ nhỏ (0-12 tuổi)
  PREGNANT_MOM     // Mẹ chuẩn bị mang thai & Đang mang thai
  POSTPARTUM_MOM   // Mẹ sau sinh & Đang cho con bú
  ADULT_HEALTH     // Người trưởng thành, Dân văn phòng & Phục hồi
  ELDERLY          // Người cao tuổi & Hỗ trợ xương khớp, tim mạch
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum ConsultationStatus {
  PENDING          // Chờ Dược sĩ liên hệ
  CONFIRMED        // Đã xếp lịch gọi
  COMPLETED        // Đã hoàn tất tư vấn chuyên môn
  CANCELLED        // Khách hàng hoặc Dược sĩ hủy lịch
}

enum GiftBoxType {
  WOODEN_BOX           // Hộp gỗ thông sơn mài khắc laser
  LEATHER_CASE         // Hộp da lót nhung rượu vang sang trọng
  BAMBOO_HAMPER        // Giỏ mây tre đan thủ công truyền thống
  CHERRY_CARGO_BOX     // Hộp chuyên dụng Air-Cargo Cherry đỏ ép kim
  LUXURY_MAGNETIC_BOX  // Hộp cứng nam châm nắp gập cao cấp
}

enum GiftRibbonColor {
  RUBY_RED         // Đỏ rượu Ruby (nhận diện THUYNGA Shop)
  CHAMPAGNE_GOLD   // Vàng Champagne ánh kim
  EMERALD_GREEN    // Xanh ngọc lục bảo
  ROYAL_NAVY       // Xanh Navy trầm quý phái
}

enum GiftOccasion {
  TET_HOLIDAY           // Quà Tết Nguyên Đán & Năm Mới
  MID_AUTUMN            // Quà Tết Trung Thu đoàn viên
  CORPORATE_THANK_YOU   // Quà Tri Ân Khách Hàng & Đối Tác Doanh Nghiệp
  BIRTHDAY              // Quà Sinh Nhật & Kỷ Niệm
  NEWBORN_BABY          // Quà Mừng Đầy Tháng & Thôi Nôi Bé
  PARENTS_HEALTH        // Quà Báo Hiếu Cha Mẹ & Chúc Thọ
}

enum CorporateGiftStatus {
  PENDING          // Tiếp nhận yêu cầu B2B
  CONTACTED        // Đã liên hệ tư vấn
  QUOTED           // Đã gửi bảng báo giá & thiết kế mẫu
  DEPOSIT_PAID     // Đã đặt cọc sản xuất
  FULFILLED        // Đã giao hàng & thanh toán
  CANCELLED        // Đã hủy yêu cầu
}

enum ChatSenderRole {
  CUSTOMER         // Khách hàng
  PHARMACIST       // Dược sĩ tư vấn chuyên môn
  SUPPORT_AGENT    // Chuyên viên CSKH / Admin
  SYSTEM_BOT       // Tin nhắn tự động hệ thống
}

enum ChatSessionStatus {
  ACTIVE               // Cuộc hội thoại đang diễn ra
  PENDING_PHARMACIST   // Cần Dược sĩ tham vấn chuyên môn
  RESOLVED             // Đã giải đáp thỏa đáng
  CLOSED               // Đã đóng phiên chat
}

enum ChatMessageType {
  TEXT             // Tin nhắn văn bản thuần túy
  IMAGE            // Ảnh chụp bao bì, hóa đơn, triệu chứng
  PRODUCT_CARD     // Thẻ sản phẩm đính kèm nút xem/mua nhanh
  ORDER_CARD       // Thẻ tra cứu trạng thái đơn hàng
}

enum NutrientUnit {
  MG               // Milligram (mg)
  MCG              // Microgram (mcg)
  G                // Gram (g)
  IU               // International Unit (IU)
  CFU              // Colony Forming Units (CFU cho men vi sinh probiotics)
  PERCENT          // Phần trăm (%)
  MGO              // Chỉ số kháng khuẩn Methylglyoxal (MGO cho mật ong Manuka)
}

enum ComparisonScope {
  GENERAL          // So sánh tổng quan quy cách & giá
  INFANT_FORMULA   // Sữa công thức & Dinh dưỡng mẹ bé
  SUPPLEMENTS      // Thực phẩm chức năng & Vi chất Úc
  MANUKA_HONEY     // Mật ong Manuka cao cấp Úc/New Zealand
  FRESH_FRUITS     // Trái cây tươi bay Air (Cherry, Nho tiêu chuẩn)
}

enum SynergyType {
  SYNERGY_BENEFICIAL     // Tác dụng hiệp đồng tương hỗ có lợi (VD: Vitamin D3 + K2 tăng hấp thụ Canxi)
  CAUTION_OVERDOSE       // Cảnh báo trùng lặp vi chất có nguy cơ vượt ngưỡng tối đa UL
  INTERACTION_SEPARATE   // Cần dùng cách thời điểm (VD: Canxi và Sắt nên uống cách nhau 2 giờ)
  NEUTRAL                // Dùng phối hợp bình thường
}

enum FlightStatus {
  SCHEDULED            // Đã lên lịch bay
  DEPARTED             // Đã cất cánh từ sân bay Úc (SYD / MEL / HBA)
  CRUISING             // Đang bay trên không phận quốc tế
  LANDED               // Đã hạ cánh tại Việt Nam (HAN / SGN)
  CUSTOMS_CLEARING     // Đang làm thủ tục thông quan hải quan & kiểm dịch
  STORED_COLD          // Đã nhập kho mát tiêu chuẩn THUYNGA Shop
}

enum ColdChainCategory {
  ULTRA_COLD_CHERRY    // Chuỗi lạnh sâu 0°C - 4°C (Cherry Tasmania, Trái cây tươi bay Air)
  COOL_PROBIOTICS      // Chuỗi mát 2°C - 8°C (Men vi sinh sống, tinh dầu thông đỏ)
  CONTROLLED_AMBIENT   // Nhiệt độ phòng tiêu chuẩn 18°C - 24°C (Sữa Aptamil, TPCN, Mật ong Manuka)
}

enum SensorAlertLevel {
  NORMAL               // Nhiệt độ trong ngưỡng chuẩn hoàn hảo
  WARNING              // Nhiệt độ chạm ngưỡng cận kề
  CRITICAL             // Nhiệt độ vượt ngưỡng cho phép (báo động đỏ)
}

enum CampaignStatus {
  UPCOMING             // Sắp diễn ra
  OPEN_FOR_RESERVATION // Đang mở đặt cọc giữ chỗ
  HARVESTING           // Đang thu hoạch tại nông trường Úc
  AIR_SHIPPING         // Đang bay Air về Việt Nam
  DELIVERED            // Đã trả hàng hoàn tất
  CLOSED               // Đã đóng chiến dịch
}

enum DepositType {
  PERCENTAGE_30        // Cọc 30% giá trị
  PERCENTAGE_50        // Cọc 50% giá trị
  FULL_PAYMENT         // Thanh toán 100% giữ suất ưu tiên
}

enum HarvestQualityGrade {
  PREMIUM_EXPORT       // Chuẩn xuất khẩu loại 1
  ROYAL_RESERVE        // Dòng thượng hạng hoàng gia
  DIAMOND_SELECT       // Tuyển chọn kim cương độc quyền
}

enum ReservationStatus {
  CONFIRMED_DEPOSIT    // Đã cọc thành công
  PAID_FULL            // Đã thanh toán toàn bộ
  ALLOCATED_FLIGHT     // Đã phân bổ slot khoang hàng máy bay
  SHIPPED              // Đang giao tận tay khách
  COMPLETED            // Hoàn thành đơn đặt trước
  CANCELLED            // Đã hủy & hoàn cọc
}

// ============================================================
// USER / AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  name          String?
  passwordHash  String?   // null nếu dùng OAuth
  role          Role      @default(CUSTOMER)
  avatar        String?
  isActive      Boolean   @default(true)
  
  // Loyalty & Membership (THUYNGA Club)
  loyaltyPoints       Int                   @default(0)       // Điểm khả dụng hiện tại
  totalPointsEarned   Int                   @default(0)       // Tổng điểm tích lũy trọn đời
  membershipTier      MembershipTier        @default(BRONZE)  // Hạng thành viên hiện tại

  // Referral & Affiliate
  referralCode        String?               @unique           // Mã mời độc quyền (ví dụ TNREF8A9B)
  referredById        String?                                 // ID người đã giới thiệu user này
  referredBy          User?                 @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]                @relation("UserReferrals")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  reviews             Review[]
  wishlist            Wishlist[]
  addresses           Address[]
  cart                Cart?
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  referralRecords     ReferralRecord[]      @relation("ReferrerUser")
  referredRecord      ReferralRecord?       @relation("RefereeUser")
  subscriptions       Subscription[]
  helpfulVotes        ReviewHelpfulVote[]
  productQuestions    ProductQuestion[]
  productAnswers      ProductAnswer[]
  healthAssessments     UserHealthAssessment[]
  consultationBookings  PharmacistConsultationBooking[]
  customHampers         GiftCustomHamper[]
  corporateGiftInquiries CorporateGiftInquiry[]
  chatSessions          ChatSession[]
  preOrderReservations  PreOrderReservation[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

// NextAuth.js required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  province   String  // Tỉnh/Thành phố
  district   String  // Quận/Huyện
  ward       String  // Phường/Xã
  street     String  // Số nhà, tên đường
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// CATEGORY (2 cấp: parent → child)
// ============================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  image       String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  seoTitle    String?
  seoDesc     String?

  // Self-relation
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text  // Rich text (HTML)
  shortDesc      String?   // Mô tả ngắn cho card
  categoryId     String
  brand          String?   // Thương hiệu
  origin         String?   // Xuất xứ (Hàn Quốc, Nhật Bản...)
  specification  String?   // Quy cách (hộp/30 viên, chai/500ml...)
  expiryInfo     String?   // Thông tin hạn sử dụng (HSD: 24 tháng từ NSX)
  isFeatured     Boolean   @default(false)
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDesc        String?
  seoKeywords    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  category       Category        @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  questions      ProductQuestion[]
  wishlist       Wishlist[]
  flashSaleItems FlashSaleItem[]
  tags           ProductTag[]
  batches        ProductBatch[]
  protocolItems  ProtocolProductItem[]
  giftHamperItems GiftHamperItem[]
  nutrients      ProductNutrient[]
  comparisonFeature ProductComparisonFeature?

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANT (SKU riêng biệt)
// Mỗi biến thể có: tên, SKU, giá, tồn kho, ảnh riêng
// VD: "Hương Táo 500g", "Hương Nho 500g", "Combo 3 hộp"
// ============================================================

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String   // Tên biến thể: "Hương Táo / 500g"
  sku           String   @unique
  price         Decimal  @db.Decimal(12, 0)  // Giá bán (VNĐ)
  originalPrice Decimal? @db.Decimal(12, 0)  // Giá gốc (để hiện % giảm)
  stock         Int      @default(0)          // Tồn kho
  image         String?                       // Ảnh riêng của biến thể
  weight        Int?                          // Gram (tính phí ship)
  isDefault     Boolean  @default(false)      // Biến thể mặc định khi vào trang SP
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  cartItems      CartItem[]
  flashSaleItems FlashSaleItem[]
  batches        ProductBatch[]
  protocolItems  ProtocolProductItem[]
  giftHamperItems GiftHamperItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// ============================================================
// PRODUCT IMAGE (thư viện ảnh sản phẩm)
// ============================================================

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================================
// PRODUCT TAG
// ============================================================

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ============================================================
// FLASH SALE
// ============================================================

model FlashSale {
  id          String    @id @default(cuid())
  name        String
  description String?
  bannerImage String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  items       FlashSaleItem[]

  @@index([startTime, endTime])
  @@map("flash_sales")
}

model FlashSaleItem {
  id              String    @id @default(cuid())
  flashSaleId     String
  productId       String
  variantId       String
  salePrice       Decimal   @db.Decimal(12, 0)   // Giá Flash Sale
  quantity        Int       // Tổng số lượng cho phép
  soldCount       Int       @default(0)            // Đã bán trong Flash Sale
  limitPerUser    Int       @default(1)            // Giới hạn mỗi khách

  flashSale       FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([flashSaleId, variantId])
  @@index([flashSaleId])
  @@map("flash_sale_items")
}

// ============================================================
// CART (Guest cart dùng sessionId, User cart dùng userId)
// ============================================================

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique   // null = guest cart
  sessionId  String?    @unique   // cho guest
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  variantId   String
  quantity    Int
  addedAt     DateTime @default(now())

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// VOUCHER / COUPON
// ============================================================

model Voucher {
  id              String      @id @default(cuid())
  code            String      @unique
  type            VoucherType
  value           Decimal     @db.Decimal(10, 2)   // % hoặc VNĐ hoặc ship
  minOrderAmount  Decimal?    @db.Decimal(12, 0)   // Đơn tối thiểu
  maxDiscount     Decimal?    @db.Decimal(12, 0)   // Giảm tối đa (cho loại %)
  usageLimit      Int?        // Tổng lượt dùng tối đa
  usedCount       Int         @default(0)
  userLimit       Int         @default(1)           // Mỗi user dùng tối đa n lần
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  orders          Order[]

  @@index([code])
  @@index([startDate, endDate])
  @@map("vouchers")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique  // TN-20261023-0001
  userId          String?
  addressId       String?
  voucherId       String?
  subscriptionId  String?
  giftHamperId    String?
  
  // Snapshot địa chỉ lúc đặt (tránh thay đổi sau)
  recipientName   String
  recipientPhone  String
  shippingAddress String        // JSON string hoặc text đầy đủ

  subtotal        Decimal       @db.Decimal(12, 0)  // Tổng trước giảm
  shippingFee     Decimal       @db.Decimal(12, 0)  @default(0)
  discountAmount  Decimal       @db.Decimal(12, 0)  @default(0)
  
  // Điểm tích lũy & Giảm giá điểm (THUYNGA Club)
  pointsEarned    Int           @default(0)         // Điểm tích lũy nhận được từ đơn
  pointsRedeemed  Int           @default(0)         // Điểm dùng để thanh toán
  pointsDiscount  Decimal       @db.Decimal(12, 0)  @default(0) // Số tiền giảm từ điểm
  
  total           Decimal       @db.Decimal(12, 0)  // Tổng thanh toán cuối cùng

  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  
  note            String?       @db.Text
  adminNote       String?       @db.Text  // Ghi chú nội bộ
  
  // VietQR info
  transferCode    String?       // Mã chuyển khoản (nội dung CK)
  paidAt          DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  address             Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  voucher             Voucher?              @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  subscription        Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  giftHamper          GiftCustomHamper?     @relation(fields: [giftHamperId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]
  referralRecords     ReferralRecord[]
  reviews             Review[]

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@index([subscriptionId])
  @@index([giftHamperId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  variantId     String?  // null nếu variant bị xóa
  
  // Snapshot thông tin lúc mua (QUAN TRỌNG: lưu snapshot để tránh thay đổi giá sau)
  productName   String
  variantName   String
  sku           String
  price         Decimal  @db.Decimal(12, 0)  // Giá tại thời điểm mua
  quantity      Int
  image         String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================================
// LOYALTY & REWARDS (THUYNGA Club)
// ============================================================

model LoyaltyTransaction {
  id           String      @id @default(cuid())
  userId       String
  orderId      String?
  points       Int         // Dương = Cộng điểm, Âm = Trừ điểm
  type         LoyaltyType
  description  String
  balanceAfter Int         // Số dư điểm sau khi thực hiện giao dịch
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

// ============================================================
// REVIEW & UGC (AUSTRALIAN AIR-CARGO VERIFIED)
// ============================================================

model Review {
  id                  String              @id @default(cuid())
  productId           String
  userId              String
  orderId             String?
  rating              Int                 // 1-5 (Overall sao tổng thể)
  packagingRating     Int?                // 1-5 (Đóng gói & Giữ nhiệt Air-cargo)
  freshnessRating     Int?                // 1-5 (Date HSD mới chuẩn Úc)
  effectivenessRating Int?                // 1-5 (Hiệu quả & Bé hợp vị)
  content             String?             @db.Text
  images              String[]            // Array of image URLs (UGC unboxing, Airway bill)
  isVerifiedBuyer     Boolean             @default(false)
  airCargoVerified    Boolean             @default(true)
  helpfulCount        Int                 @default(0)
  adminReply          String?             @db.Text // Phản hồi từ Dược sĩ / CSKH THUYNGA
  adminReplyAt        DateTime?
  rewardPoints        Int                 @default(0) // Điểm THUYNGA Club đã thưởng
  status              ReviewStatus        @default(PENDING)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  helpfulVotes        ReviewHelpfulVote[]

  @@unique([productId, userId])  // Mỗi user review 1 lần / sản phẩm
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful_votes")
}

model ProductQuestion {
  id         String          @id @default(cuid())
  productId  String
  userId     String
  question   String          @db.Text
  isAnswered Boolean         @default(false)
  status     ReviewStatus    @default(APPROVED) // PENDING, APPROVED, REJECTED
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    ProductAnswer[]

  @@index([productId])
  @@index([status])
  @@map("product_questions")
}

model ProductAnswer {
  id         String          @id @default(cuid())
  questionId String
  userId     String
  answer     String          @db.Text
  isOfficial Boolean         @default(false) // Dược sĩ / Quản trị viên THUYNGA trả lời
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("product_answers")
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text  // Rich text HTML
  coverImage  String?
  category    String    @default("Cẩm nang sức khỏe")
  authorName  String    @default("Dược sĩ Thu Nga")
  readingTime Int       @default(5)
  viewCount   Int       @default(0)
  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("blog_posts")
}

// ============================================================
// SITE SETTINGS (Admin tự sửa logo, banner, footer, SEO...)
// Lưu dạng key-value JSON
// ============================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique  // "homepage_banner", "footer_content", "site_logo"...
  value     Json                // Flexible JSON value
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ============================================================
// MEDIA LIBRARY (Kho ảnh Admin)
// ============================================================

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int      // bytes
  width     Int?
  height    Int?
  altText   String?
  createdAt DateTime @default(now())

  @@map("media")
}

// ============================================================
// IN-APP NOTIFICATIONS (Trung tâm thông báo & chuông báo)
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?          // Đường dẫn khi nhấp vào thông báo
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// REFERRAL & AFFILIATE PROGRAM (Mời Bạn Nhận Quà)
// ============================================================

model ReferralRecord {
  id                    String         @id @default(cuid())
  referrerId            String         // Người giới thiệu (chủ link)
  refereeId             String         @unique // Người được giới thiệu (bạn bè)
  orderId               String?        // Đơn hàng đầu tiên đủ điều kiện nhận thưởng
  status                ReferralStatus @default(PENDING)
  referrerRewardPoints  Int            @default(500) // Điểm thưởng cho người giới thiệu
  refereeVoucherCode    String?        // Mã voucher chào mừng tặng bạn mới
  rewardedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  referrer User   @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([status])
  @@map("referral_records")
}

// ============================================================
// SUBSCRIBE & SAVE / AUTO-SHIP (Giao Hàng Định Kỳ Tiết Kiệm)
// ============================================================

model Subscription {
  id                    String                @id @default(cuid())
  subscriptionNumber    String                @unique // SUB-2026-XXXX
  userId                String
  frequency             SubscriptionFrequency @default(EVERY_1_MONTH)
  status                SubscriptionStatus    @default(ACTIVE)
  discountPercent       Int                   @default(10) // Mặc định giảm 10% trọn đời
  
  startDate             DateTime              @default(now())
  nextDeliveryDate      DateTime              // Ngày dự kiến giao kỳ tiếp theo
  lastDeliveryDate      DateTime?             // Ngày giao kỳ gần nhất
  totalCyclesDelivered  Int                   @default(0)  // Số kỳ đã giao thành công

  // Thông tin nhận hàng mặc định cho gói định kỳ
  recipientName         String
  recipientPhone        String
  shippingAddress       String
  paymentMethod         PaymentMethod         @default(COD)
  note                  String?               @db.Text

  pausedAt              DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 SubscriptionItem[]
  orders                Order[]

  @@index([userId])
  @@index([status])
  @@index([nextDeliveryDate])
  @@map("subscriptions")
}

model SubscriptionItem {
  id              String        @id @default(cuid())
  subscriptionId  String
  variantId       String?       // null nếu biến thể bị gỡ
  productName     String
  variantName     String
  sku             String
  originalPrice   Decimal       @db.Decimal(12, 0) // Giá gốc niêm yết
  price           Decimal       @db.Decimal(12, 0) // Giá sau giảm 10% định kỳ
  quantity        Int           @default(1)
  image           String?

  // Relations
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_items")
}

// ============================================================
// AIR-CARGO SHIPMENTS & BATCH TRANSPARENCY (PHASE 15)
// ============================================================

model AirCargoShipment {
  id                  String          @id @default(cuid())
  shipmentNumber      String          @unique // Ví dụ: AWB-VN782-202611
  airWaybillNumber    String          // Số vận đơn AWB chính thức: 738-12345678
  carrier             AirlineCarrier  @default(VIETNAM_AIRLINES_CARGO)
  flightNumber        String          // Số hiệu chuyến bay (VN782, QF43...)
  originAirport       String          // SYD (Sydney Kingsford Smith) hoặc MEL (Melbourne)
  destinationAirport   String          // HAN (Sân bay quốc tế Nội Bài)
  departureDate       DateTime        // Ngày cất cánh từ Úc
  arrivalDate         DateTime        // Ngày hạ cánh tại Việt Nam
  status              ShipmentStatus  @default(IN_WAREHOUSE)
  storageTempMin      Float           @default(18.0) // Nhiệt độ bảo quản tối thiểu (°C)
  storageTempMax      Float           @default(24.0) // Nhiệt độ bảo quản tối đa (°C)
  temperatureLog      Json?           // Bản ghi đo nhiệt độ theo thời gian [{ time: "...", temp: 20.5 }]
  receiptImages       String[]        // Ảnh hóa đơn mua hàng gốc từ Chemist Warehouse / Coles / Woolworths Úc
  customsDocImages    String[]        // Ảnh tờ khai hải quan & chứng thư kiểm dịch bay air
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  batches             ProductBatch[]
  flights             AirCargoFlight[]

  @@index([airWaybillNumber])
  @@index([status])
  @@index([arrivalDate])
  @@map("air_cargo_shipments")
}

model ProductBatch {
  id                String            @id @default(cuid())
  batchCode         String            @unique // Ví dụ: BATCH-APT-2026-SYD hoặc in dưới đáy lon
  productId         String
  variantId         String?
  shipmentId        String
  manufactureDate   DateTime          // Ngày sản xuất (NSX)
  expiryDate        DateTime          // Hạn sử dụng (HSD)
  importedQuantity  Int               // Số lượng nhập kho đợt này
  remainingStock    Int               // Số lượng còn lại thực tế
  australianBarcode String?           // Mã vạch chuẩn Úc (93x...)
  chemistSource     String?           // Chemist Warehouse Victoria / George St Sydney...
  certificateUrl    String?           // Chứng thư chất lượng đi kèm
  isActive          Boolean           @default(true) // Đang là lô hàng lưu hành hiện tại
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipment          AirCargoShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  verificationLogs  BatchVerificationLog[]

  @@index([productId])
  @@index([variantId])
  @@index([shipmentId])
  @@index([batchCode])
  @@index([expiryDate])
  @@map("product_batches")
}

model BatchVerificationLog {
  id          String        @id @default(cuid())
  batchId     String
  batchCode   String
  ipAddress   String?
  userAgent   String?
  verifiedAt  DateTime      @default(now())

  batch       ProductBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([verifiedAt])
  @@map("batch_verification_logs")
}

// ============================================================
// HEALTH QUIZ & PERSONALIZED SUPPLEMENT PROTOCOLS (PHASE 16)
// ============================================================

model HealthQuizQuestion {
  id              String            @id @default(cuid())
  targetGroup     HealthTargetGroup
  questionText    String            // Nội dung câu hỏi chuyên môn
  subtitle        String?           // Hướng dẫn giải thích thêm
  stepNumber      Int               // Thứ tự bước trong quiz (1, 2, 3...)
  questionType    QuizQuestionType  @default(SINGLE_CHOICE)
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  options         QuizOption[]

  @@index([targetGroup, stepNumber])
  @@index([isActive])
  @@map("health_quiz_questions")
}

model QuizOption {
  id              String              @id @default(cuid())
  questionId      String
  label           String              // Tiêu đề lựa chọn
  subtitle        String?             // Mô tả chi tiết
  icon            String?             // Tên Lucide icon (e.g. Baby, Heart, Shield)
  recommendedTags String[]            // Tags vi chất dinh dưỡng khuyến nghị: ["probiotic", "zinc", "dha"]
  protocolSlug    String?             // Slug phác đồ liên kết trực tiếp nếu chọn đáp án này
  sortOrder       Int                 @default(0)

  question        HealthQuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model HealthProtocol {
  id                    String                @id @default(cuid())
  slug                  String                @unique // Ví dụ: phac-do-be-tieu-hoa-kem-bieng-an
  title                 String                // Tiêu đề phác đồ
  targetGroup           HealthTargetGroup
  subtitle              String?
  description           String                @db.Text
  keyNutrients          String[]              // Các dưỡng chất cốt lõi: ["Men vi sinh 15 chủng", "Kẽm sinh học Zinc", "Lactoferrin"]
  pharmacistAdvice      String                @db.Text // Lời khuyên & chỉ định từ Dược sĩ THUYNGA Shop
  dosageSchedule        Json                  // Biểu đồ liều dùng sáng / trưa / tối
  comboDiscountPercent  Int                   @default(10) // % giảm giá khi mua trọn bộ combo phác đồ
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items                 ProtocolProductItem[]
  assessments           UserHealthAssessment[]

  @@index([targetGroup])
  @@index([isActive])
  @@map("health_protocols")
}

model ProtocolProductItem {
  id                String          @id @default(cuid())
  protocolId        String
  productId         String
  variantId         String?
  usageInstructions String          // Cách dùng chi tiết: "1 gói sau ăn sáng 30 phút cùng 50ml nước ấm"
  timing            String          // "Sáng", "Trưa", "Tối", "Trước khi ngủ"
  quantity          Int             @default(1)
  isEssential       Boolean         @default(true) // Sản phẩm cốt lõi bắt buộc hay tùy chọn bổ trợ
  sortOrder         Int             @default(0)

  protocol          HealthProtocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([protocolId])
  @@index([productId])
  @@index([variantId])
  @@map("protocol_product_items")
}

model UserHealthAssessment {
  id                    String                          @id @default(cuid())
  userId                String?
  targetGroup           HealthTargetGroup
  quizAnswers           Json                            // Bản ghi các câu trả lời trắc nghiệm
  protocolId            String?
  customerName          String
  customerPhone         String
  customerEmail         String?
  notes                 String?                         @db.Text
  isSavedToProfile      Boolean                         @default(false)
  createdAt             DateTime                        @default(now())

  user                  User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  protocol              HealthProtocol?                 @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  consultationBookings  PharmacistConsultationBooking[]

  @@index([userId])
  @@index([protocolId])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("user_health_assessments")
}

model PharmacistConsultationBooking {
  id                String                @id @default(cuid())
  assessmentId      String?
  userId            String?
  customerName      String
  phone             String
  preferredDate     DateTime
  preferredTimeSlot String                // Ví dụ: "09:00 - 11:30" hoặc "14:00 - 16:30"
  healthConcerns    String                @db.Text // Tình trạng sức khỏe cần Dược sĩ tư vấn chuyên sâu
  status            ConsultationStatus    @default(PENDING)
  pharmacistNotes   String?               @db.Text // Ghi chú của Dược sĩ sau khi gọi điện tư vấn
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  assessment        UserHealthAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assessmentId])
  @@index([status])
  @@index([preferredDate])
  @@map("pharmacist_consultation_bookings")
}

// ============================================================
// PHASE 17: HỆ THỐNG GIỎ QUÀ BIẾU CAO CẤP & THIỆP CHÚC MỪNG
// (Luxury Custom Gift Box, Cherry Hamper & Corporate Gift)
// ============================================================

model GiftBoxTemplate {
  id              String          @id @default(cuid())
  name            String          // Ví dụ: "Hộp Quà Gỗ Thông Sơn Mài Hoàng Gia"
  slug            String          @unique
  boxType         GiftBoxType
  dimensions      String          // "36 x 28 x 12 cm"
  basePrice       Decimal         @db.Decimal(12, 0) // Giá vỏ hộp đã gồm rơm lót lụa và thiệp
  maxSlots        Int             @default(5)        // Sức chứa tối đa (slots)
  imageUrl        String
  description     String?         @db.Text
  isAirCargoPledge Boolean        @default(true)     // Chuẩn bảo ôn giữ lạnh cho Cherry & Probiotics
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  hampers         GiftCustomHamper[]

  @@index([slug])
  @@index([boxType])
  @@index([isActive])
  @@map("gift_box_templates")
}

model GiftCustomHamper {
  id                  String            @id @default(cuid())
  hamperCode          String            @unique // Ví dụ: "HMP-202611-001"
  templateId          String
  userId              String?
  sessionId           String?           // Hỗ trợ khách vãng lai tùy biến giỏ quà
  occasion            GiftOccasion      @default(TET_HOLIDAY)
  ribbonColor         GiftRibbonColor   @default(RUBY_RED)
  hasWaxSeal          Boolean           @default(true) // Dấu niêm phong sáp đồng logo THUYNGA
  hasLedLights        Boolean           @default(false) // Dây đèn LED đom đóm ấm áp (+50.000đ)
  greetingCardMessage String?           @db.Text       // Lời chúc in thiệp trang trọng
  cardSenderName      String?                          // Người gửi: "Gia đình Bác Thành", "Công ty ABC"
  cardReceiverName    String?                          // Kính tặng: "Bác sĩ Hoàng", "Đối tác Quý mến"
  totalPrice          Decimal           @db.Decimal(12, 0)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  template            GiftBoxTemplate   @relation(fields: [templateId], references: [id])
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               GiftHamperItem[]
  orders              Order[]

  @@index([hamperCode])
  @@index([userId])
  @@index([sessionId])
  @@index([templateId])
  @@index([createdAt])
  @@map("gift_custom_hampers")
}

model GiftHamperItem {
  id          String            @id @default(cuid())
  hamperId    String
  productId   String
  variantId   String?
  quantity    Int               @default(1)
  unitPrice   Decimal           @db.Decimal(12, 0)
  slotCost    Int               @default(1) // Số slots chiếm dụng trong hộp (1 đến 3)

  hamper      GiftCustomHamper  @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([hamperId])
  @@index([productId])
  @@index([variantId])
  @@map("gift_hamper_items")
}

model CorporateGiftInquiry {
  id                  String              @id @default(cuid())
  inquiryCode         String              @unique // Ví dụ: "CORP-202611-001"
  companyName         String
  contactPerson       String
  phone               String
  email               String
  occasion            GiftOccasion        @default(CORPORATE_THANK_YOU)
  quantity            Int                 // Số lượng suất quà (50, 100, 500...)
  budgetPerHamper     Decimal             @db.Decimal(12, 0) // Ngân sách dự kiến mỗi suất (VNĐ)
  deliveryDeadline    DateTime?
  requiresVatInvoice  Boolean             @default(true)     // Xuất hóa đơn đỏ VAT 8-10%
  customLogoBranding  Boolean             @default(true)     // Khắc laser logo doanh nghiệp lên hộp/ruy băng
  notes               String?             @db.Text
  status              CorporateGiftStatus @default(PENDING)
  quotedTotal         Decimal?            @db.Decimal(12, 0) // Tổng tiền báo giá chính thức
  adminNotes          String?             @db.Text           // Ghi chú đàm phán nội bộ
  userId              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([inquiryCode])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("corporate_gift_inquiries")
}

// ============================================================
// PHASE 18: HỆ THỐNG LIVE CHAT & HỖ TRỢ ĐA KÊNH DƯỢC SĨ / CSKH
// (Multi-channel Live Chat, Pharmacist Consultation & Support)
// ============================================================

model ChatSession {
  id                  String            @id @default(cuid())
  sessionCode         String            @unique // Ví dụ: "CHAT-202611-001"
  userId              String?
  guestSessionId      String?           // Hỗ trợ khách vãng lai lưu session
  customerName        String
  customerPhone       String?
  customerEmail       String?
  status              ChatSessionStatus @default(ACTIVE)
  assignedTo          String?           // Tên Dược sĩ hoặc CSKH phụ trách
  unreadCustomerCount Int               @default(0) // Số tin chưa đọc phía khách
  unreadAdminCount    Int               @default(0) // Số tin chưa đọc phía Admin/Dược sĩ
  lastMessageText     String?           @db.Text
  lastMessageAt       DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages            ChatMessage[]

  @@index([sessionCode])
  @@index([userId])
  @@index([guestSessionId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id                  String          @id @default(cuid())
  sessionId           String
  senderRole          ChatSenderRole
  senderName          String
  messageType         ChatMessageType @default(TEXT)
  content             String          @db.Text
  mediaUrl            String?
  metadata            Json?           // Lưu productId, orderId, badge info
  isRead              Boolean         @default(false)
  createdAt           DateTime        @default(now())

  session             ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([senderRole])
  @@index([createdAt])
  @@map("chat_messages")
}

// ============================================================
// PHASE 19: BỘ SO SÁNH SẢN PHẨM & PHÂN TÍCH VI CHẤT THÔNG MINH
// (Australian Product Comparison, Nutrient Synergy & Safety Matrix)
// ============================================================

model NutrientReference {
  id                  String             @id @default(cuid())
  code                String             @unique // Ví dụ: "DHA", "SYNBIOTICS", "MGO", "GLUCOSAMINE", "ZINC", "CALCIUM"
  nameVi              String             // Ví dụ: "DHA Tinh Khiết Từ Vi Tảo"
  nameEn              String?            // "Docosahexaenoic Acid"
  category            String             // "Axit Béo Omega", "Khoáng Chất", "Men Vi Sinh", "Vitamin", "Kháng Khuẩn Tự Nhiên"
  standardRdi         Decimal?           @db.Decimal(10, 2) // Khuyến nghị hàng ngày RDI
  upperLimit          Decimal?           @db.Decimal(10, 2) // Giới hạn tối đa an toàn mỗi ngày (UL)
  unit                NutrientUnit       @default(MG)
  benefitsSummary     String             @db.Text // Tóm tắt lợi ích sức khỏe
  cautionNotes        String?            @db.Text // Lưu ý sử dụng
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  productNutrients    ProductNutrient[]
  primarySynergies    NutrientSynergyRule[] @relation("PrimaryNutrient")
  secondarySynergies  NutrientSynergyRule[] @relation("SecondaryNutrient")

  @@index([code])
  @@index([category])
  @@map("nutrient_references")
}

model ProductNutrient {
  id                  String             @id @default(cuid())
  productId           String
  nutrientRefId       String
  amountPerServing    Decimal            @db.Decimal(10, 2) // Hàm lượng trên 1 liều dùng
  amountPer100g       Decimal?           @db.Decimal(10, 2) // Hàm lượng trên 100g/100ml
  servingSizeText     String?            // Ví dụ: "1 viên/ngày" hoặc "8.8g pha 50ml"
  percentDailyValue   Decimal?           @db.Decimal(6, 2)  // % RDI (ví dụ: 120%)
  highlightClaim      String?            // Ví dụ: "Hàm lượng DHA cao nhất phân khúc"
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  nutrientRef         NutrientReference  @relation(fields: [nutrientRefId], references: [id], onDelete: Cascade)

  @@unique([productId, nutrientRefId])
  @@index([productId])
  @@index([nutrientRefId])
  @@map("product_nutrients")
}

model ProductComparisonFeature {
  id                      String           @id @default(cuid())
  productId               String           @unique
  scope                   ComparisonScope  @default(GENERAL)
  costPerDay              Decimal?         @db.Decimal(12, 0) // Chi phí trung bình ngày dùng (VNĐ)
  servingsPerPack         Int?             // Số ngày / liều dùng trong 1 hộp
  australianCertification  String?          // "TGA AUST L 312345", "ACO Certified Organic"
  targetAgeGroup          String?          // "Trẻ 0-6 tháng", "Người cao tuổi", "Cả gia đình"
  textureOrFlavor         String?          // "Vị thanh mát giống sữa mẹ", "Hạt dẻo, ngọt thanh"
  keyDifferentiators      Json?            // Mảng string 3-4 điểm nổi bật độc quyền
  storageInstruction      String?          // "Bảo quản ngăn mát 0-4°C sau khi mở"
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  product                 Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@map("product_comparison_features")
}

model NutrientSynergyRule {
  id                      String           @id @default(cuid())
  primaryNutrientId       String
  secondaryNutrientId     String
  synergyType             SynergyType      @default(SYNERGY_BENEFICIAL)
  title                   String           // "DHA kết hợp Lutein: Hiệp đồng tối ưu tế bào võng mạc"
  description             String           @db.Text
  pharmacistRecommendation String?         @db.Text
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  primaryNutrient         NutrientReference @relation("PrimaryNutrient", fields: [primaryNutrientId], references: [id], onDelete: Cascade)
  secondaryNutrient       NutrientReference @relation("SecondaryNutrient", fields: [secondaryNutrientId], references: [id], onDelete: Cascade)

  @@unique([primaryNutrientId, secondaryNutrientId])
  @@index([primaryNutrientId])
  @@index([secondaryNutrientId])
  @@index([synergyType])
  @@map("nutrient_synergy_rules")
}

// ============================================================
// PHASE 20: HỆ THỐNG GIÁM SÁT CHUYẾN BAY AIR CARGO THỜI GIAN THỰC & CHUỖI LẠNH
// (Realtime Air Cargo Flight Tracker, Cold-Chain Sensor Log & Radar Map)
// ============================================================

model AirCargoFlight {
  id                     String              @id @default(cuid())
  flightNumber           String              @unique // Ví dụ: "VN780", "VN772", "QF7561"
  aircraftType           String              // "Boeing 787-9 Dreamliner", "Airbus A350-900"
  carrier                AirlineCarrier      @default(VIETNAM_AIRLINES_CARGO)
  originAirport          String              // "MEL", "SYD", "HBA"
  originCity             String              // "Melbourne", "Sydney", "Hobart Tasmania"
  destAirport            String              // "HAN", "SGN"
  destCity               String              // "Hà Nội", "TP. Hồ Chí Minh"
  scheduledDeparture     DateTime
  actualDeparture        DateTime?
  scheduledArrival       DateTime
  actualArrival          DateTime?
  flightDurationMinutes  Int                 @default(540) // 9 giờ bay
  flightStatus           FlightStatus        @default(LANDED)
  flightProgressPercent  Int                 @default(100) // 0% - 100%
  currentLatitude        Float?
  currentLongitude       Float?
  currentAltitudeFeet    Int?
  coldChainCategory      ColdChainCategory   @default(ULTRA_COLD_CHERRY)
  targetTempMin          Float               @default(0.0) // 0°C
  targetTempMax          Float               @default(4.0) // 4°C
  averageTemp            Float?              // Nhiệt độ trung bình thực tế đo được (VD: 2.1°C)
  isColdChainPassed      Boolean             @default(true)
  totalCargoWeightKg     Float?              // 4250.5 (kg)
  cargoManifestSummary   String?             @db.Text // "4.200 kg Cherry Tasmania & 2.500 lon Sữa Aptamil Profutura"
  shipmentId             String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  shipment               AirCargoShipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  milestones             FlightMilestone[]
  sensorLogs             ColdChainSensorLog[]

  @@index([flightNumber])
  @@index([carrier])
  @@index([flightStatus])
  @@index([scheduledArrival])
  @@map("air_cargo_flights")
}

model FlightMilestone {
  id                     String          @id @default(cuid())
  flightId               String
  stepNumber             Int             // 1, 2, 3, 4, 5
  title                  String          // "Cất cánh từ Melbourne Tullamarine"
  locationName           String          // "Sân bay Quốc tế Melbourne (MEL)"
  timestamp              DateTime
  isCompleted            Boolean         @default(false)
  notes                  String?
  createdAt              DateTime        @default(now())

  flight                 AirCargoFlight  @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@index([stepNumber])
  @@map("flight_milestones")
}

model ColdChainSensorLog {
  id                     String            @id @default(cuid())
  flightId               String
  sensorId               String            // "SENS-LOGGER-TAS-01"
  recordedAt             DateTime
  temperatureCelsius     Float             // 2.3 (°C)
  humidityPercent        Float?            // 89.5 (%)
  batteryPercent         Int?              @default(98)
  alertLevel             SensorAlertLevel  @default(NORMAL)
  stageName              String            // "Khoang hàng không máy bay VN780"
  createdAt              DateTime          @default(now())

  flight                 AirCargoFlight    @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@index([recordedAt])
  @@index([alertLevel])
  @@map("cold_chain_sensor_logs")
}

// ============================================================
// PHASE 21: AUSTRALIAN HARVEST PRE-ORDER & AIR ALLOCATION
// ============================================================

model SeasonalCampaign {
  id                     String              @id @default(cuid())
  title                  String              // "Cherry Đỏ Tasmania Vụ Thu Hoạch Tết 2026"
  slug                   String              @unique // "cherry-tasmania-tet-2026"
  subtitle               String              // "Bay Air 24h từ Thung Lũng Huon, Tasmania - Cuống xanh ngắt, size 32-34mm"
  description            String              @db.Text
  farmName               String              // "Reid Fruits Tasmania"
  farmRegion             String              // "Huon Valley, Tasmania, Australia"
  originCountry          String              @default("Australia")
  productCategory        String              @default("CHERRY") // CHERRY, MANUKA_HONEY, TASMANIAN_FRUIT
  bannerImage            String
  galleryImages          Json?               // string[]
  harvestStartDate       DateTime
  harvestEndDate         DateTime
  flightDepartureWeek    String              // "Tuần 3 Tháng 1/2026 (Đúng dịp Tết Bính Ngọ)"
  targetBrixSweetness    String              // "22.0° - 26.0° Brix"
  fruitSizeMm            String              // "32mm - 34mm (Jumbo Select)"
  qualityGrade           HarvestQualityGrade @default(ROYAL_RESERVE)
  totalCapacityKg        Float               // 5000.0 (5 tấn)
  reservedCapacityKg     Float               @default(0) // 3650.0 (đã cọc)
  status                 CampaignStatus      @default(OPEN_FOR_RESERVATION)
  depositType            DepositType         @default(PERCENTAGE_30)
  depositPercent         Int                 @default(30)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tiers                  PreOrderTier[]
  harvestUpdates         HarvestUpdate[]
  reservations           PreOrderReservation[]

  @@index([slug])
  @@index([status])
  @@index([harvestStartDate])
  @@map("seasonal_campaigns")
}

model PreOrderTier {
  id                     String              @id @default(cuid())
  campaignId             String
  name                   String              // "Hộp Quà 2kg Thượng Hạng - Size 32mm+"
  specification          String              // "Hộp nam châm dập kim vàng, kèm thiệp chúc Tết & túi giữ nhiệt"
  price                  Decimal             @db.Decimal(12, 2) // 1,950,000đ
  depositAmount          Decimal             @db.Decimal(12, 2) // 585,000đ (30%)
  totalSlots             Int                 // 500 hộp
  reservedSlots          Int                 @default(0)
  isAvailable            Boolean             @default(true)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  campaign               SeasonalCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reservations           PreOrderReservation[]

  @@index([campaignId])
  @@index([isAvailable])
  @@map("pre_order_tiers")
}

model HarvestUpdate {
  id                     String              @id @default(cuid())
  campaignId             String
  title                  String              // "Cập nhật ngày nắng Huon Valley: Quả chuyển sắc đỏ ruby đậm, đạt 23.5° Brix"
  content                String              @db.Text
  brixRecorded           Float?              // 23.5
  sizeRecordedMm         Float?              // 32.8
  weatherCondition       String?             // "Trời trong, 21°C nắng nhẹ"
  photos                 Json?               // string[]
  reportedAt             DateTime            @default(now())
  createdAt              DateTime            @default(now())

  campaign               SeasonalCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([reportedAt])
  @@map("harvest_updates")
}

model PreOrderReservation {
  id                     String              @id @default(cuid())
  reservationCode        String              @unique // "PRE-TAS-2026-089"
  campaignId             String
  tierId                 String
  userId                 String?
  customerName           String
  customerPhone          String
  customerEmail          String?
  deliveryAddress        String
  quantity               Int                 @default(1)
  totalPrice             Decimal             @db.Decimal(12, 2)
  depositPaid            Decimal             @db.Decimal(12, 2)
  remainingAmount        Decimal             @db.Decimal(12, 2)
  depositMethod          String              @default("VIETQR_NAPAS")
  status                 ReservationStatus   @default(CONFIRMED_DEPOSIT)
  flightNumber           String?             // "VN780" (Liên kết tới chuyến bay Air Cargo)
  airWaybillNumber       String?             // "738-49201942"
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  campaign               SeasonalCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tier                   PreOrderTier        @relation(fields: [tierId], references: [id], onDelete: Restrict)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationCode])
  @@index([campaignId])
  @@index([tierId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("pre_order_reservations")
}
