// ============================================================
// THUYNGA SHOP – Prisma Schema
// Database: PostgreSQL 16
// Cập nhật: 2026-10-23
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING        // Chờ xác nhận
  CONFIRMED      // Đã xác nhận
  PROCESSING     // Đang xử lý
  SHIPPING       // Đang giao
  DELIVERED      // Đã giao
  CANCELLED      // Đã hủy
  REFUNDED       // Đã hoàn tiền
}

enum PaymentMethod {
  COD
  VIETQR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VoucherType {
  PERCENTAGE   // Giảm theo %
  FIXED        // Giảm số tiền cố định
  FREE_SHIP    // Miễn phí vận chuyển
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipTier {
  BRONZE      // Đồng (Mặc định khi đăng ký)
  SILVER      // Bạc (Chi tiêu từ 3.000.000₫)
  GOLD        // Vàng (Chi tiêu từ 10.000.000₫)
  DIAMOND     // Kim Cương (Chi tiêu từ 25.000.000₫)
}

enum LoyaltyType {
  EARN_ORDER      // Tích điểm từ đơn hàng giao thành công
  REDEEM_ORDER    // Trừ điểm giảm giá trực tiếp lúc thanh toán
  REDEEM_VOUCHER  // Đổi điểm lấy mã giảm giá độc quyền
  ADMIN_ADJUST    // Admin điều chỉnh (thưởng/bù điểm)
  SIGNUP_BONUS    // Điểm thưởng khi đăng ký tài khoản mới
}

enum NotificationType {
  ORDER_STATUS    // Cập nhật trạng thái đơn hàng (Xác nhận, Đang giao, Đã giao, Hủy)
  PROMOTION       // Ưu đãi Flash Sale, Voucher mới
  LOYALTY_TIER    // Thăng hạng VIP, Quà tặng sinh nhật, Hoàn điểm thưởng
  SYSTEM          // Thông báo hệ thống
}

enum ReferralStatus {
  PENDING       // Người được mời đã đăng ký, chưa có đơn hàng đầu tiên
  QUALIFIED     // Đã đặt đơn đầu tiên, đang chờ giao hàng
  REWARDED      // Đơn đầu tiên giao thành công, đã thưởng điểm cho người mời
  EXPIRED       // Hết hạn hoặc đơn hàng bị hủy
}

enum SubscriptionFrequency {
  EVERY_2_WEEKS   // Mỗi 2 tuần
  EVERY_1_MONTH   // Mỗi 1 tháng (Mặc định phổ biến)
  EVERY_2_MONTHS  // Mỗi 2 tháng
  EVERY_3_MONTHS  // Mỗi 3 tháng
}

enum SubscriptionStatus {
  ACTIVE          // Đang hoạt động, chờ đến kỳ giao tiếp theo
  PAUSED          // Tạm dừng theo yêu cầu của khách hàng
  CANCELLED       // Đã hủy gói định kỳ
  EXPIRED         // Hết hiệu lực
}

// ============================================================
// USER / AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  name          String?
  passwordHash  String?   // null nếu dùng OAuth
  role          Role      @default(CUSTOMER)
  avatar        String?
  isActive      Boolean   @default(true)
  
  // Loyalty & Membership (THUYNGA Club)
  loyaltyPoints       Int                   @default(0)       // Điểm khả dụng hiện tại
  totalPointsEarned   Int                   @default(0)       // Tổng điểm tích lũy trọn đời
  membershipTier      MembershipTier        @default(BRONZE)  // Hạng thành viên hiện tại

  // Referral & Affiliate
  referralCode        String?               @unique           // Mã mời độc quyền (ví dụ TNREF8A9B)
  referredById        String?                                 // ID người đã giới thiệu user này
  referredBy          User?                 @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]                @relation("UserReferrals")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  reviews             Review[]
  wishlist            Wishlist[]
  addresses           Address[]
  cart                Cart?
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  referralRecords     ReferralRecord[]      @relation("ReferrerUser")
  referredRecord      ReferralRecord?       @relation("RefereeUser")
  subscriptions       Subscription[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

// NextAuth.js required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  province   String  // Tỉnh/Thành phố
  district   String  // Quận/Huyện
  ward       String  // Phường/Xã
  street     String  // Số nhà, tên đường
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// CATEGORY (2 cấp: parent → child)
// ============================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  image       String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  seoTitle    String?
  seoDesc     String?

  // Self-relation
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text  // Rich text (HTML)
  shortDesc      String?   // Mô tả ngắn cho card
  categoryId     String
  brand          String?   // Thương hiệu
  origin         String?   // Xuất xứ (Hàn Quốc, Nhật Bản...)
  specification  String?   // Quy cách (hộp/30 viên, chai/500ml...)
  expiryInfo     String?   // Thông tin hạn sử dụng (HSD: 24 tháng từ NSX)
  isFeatured     Boolean   @default(false)
  isActive       Boolean   @default(true)
  seoTitle       String?
  seoDesc        String?
  seoKeywords    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  category       Category        @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlist       Wishlist[]
  flashSaleItems FlashSaleItem[]
  tags           ProductTag[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANT (SKU riêng biệt)
// Mỗi biến thể có: tên, SKU, giá, tồn kho, ảnh riêng
// VD: "Hương Táo 500g", "Hương Nho 500g", "Combo 3 hộp"
// ============================================================

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String   // Tên biến thể: "Hương Táo / 500g"
  sku           String   @unique
  price         Decimal  @db.Decimal(12, 0)  // Giá bán (VNĐ)
  originalPrice Decimal? @db.Decimal(12, 0)  // Giá gốc (để hiện % giảm)
  stock         Int      @default(0)          // Tồn kho
  image         String?                       // Ảnh riêng của biến thể
  weight        Int?                          // Gram (tính phí ship)
  isDefault     Boolean  @default(false)      // Biến thể mặc định khi vào trang SP
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  cartItems      CartItem[]
  flashSaleItems FlashSaleItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// ============================================================
// PRODUCT IMAGE (thư viện ảnh sản phẩm)
// ============================================================

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================================
// PRODUCT TAG
// ============================================================

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ============================================================
// FLASH SALE
// ============================================================

model FlashSale {
  id          String    @id @default(cuid())
  name        String
  description String?
  bannerImage String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  items       FlashSaleItem[]

  @@index([startTime, endTime])
  @@map("flash_sales")
}

model FlashSaleItem {
  id              String    @id @default(cuid())
  flashSaleId     String
  productId       String
  variantId       String
  salePrice       Decimal   @db.Decimal(12, 0)   // Giá Flash Sale
  quantity        Int       // Tổng số lượng cho phép
  soldCount       Int       @default(0)            // Đã bán trong Flash Sale
  limitPerUser    Int       @default(1)            // Giới hạn mỗi khách

  flashSale       FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([flashSaleId, variantId])
  @@index([flashSaleId])
  @@map("flash_sale_items")
}

// ============================================================
// CART (Guest cart dùng sessionId, User cart dùng userId)
// ============================================================

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique   // null = guest cart
  sessionId  String?    @unique   // cho guest
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  variantId   String
  quantity    Int
  addedAt     DateTime @default(now())

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// VOUCHER / COUPON
// ============================================================

model Voucher {
  id              String      @id @default(cuid())
  code            String      @unique
  type            VoucherType
  value           Decimal     @db.Decimal(10, 2)   // % hoặc VNĐ hoặc ship
  minOrderAmount  Decimal?    @db.Decimal(12, 0)   // Đơn tối thiểu
  maxDiscount     Decimal?    @db.Decimal(12, 0)   // Giảm tối đa (cho loại %)
  usageLimit      Int?        // Tổng lượt dùng tối đa
  usedCount       Int         @default(0)
  userLimit       Int         @default(1)           // Mỗi user dùng tối đa n lần
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  orders          Order[]

  @@index([code])
  @@index([startDate, endDate])
  @@map("vouchers")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique  // TN-20261023-0001
  userId          String?
  addressId       String?
  voucherId       String?
  subscriptionId  String?
  
  // Snapshot địa chỉ lúc đặt (tránh thay đổi sau)
  recipientName   String
  recipientPhone  String
  shippingAddress String        // JSON string hoặc text đầy đủ

  subtotal        Decimal       @db.Decimal(12, 0)  // Tổng trước giảm
  shippingFee     Decimal       @db.Decimal(12, 0)  @default(0)
  discountAmount  Decimal       @db.Decimal(12, 0)  @default(0)
  
  // Điểm tích lũy & Giảm giá điểm (THUYNGA Club)
  pointsEarned    Int           @default(0)         // Điểm tích lũy nhận được từ đơn
  pointsRedeemed  Int           @default(0)         // Điểm dùng để thanh toán
  pointsDiscount  Decimal       @db.Decimal(12, 0)  @default(0) // Số tiền giảm từ điểm
  
  total           Decimal       @db.Decimal(12, 0)  // Tổng thanh toán cuối cùng

  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  
  note            String?       @db.Text
  adminNote       String?       @db.Text  // Ghi chú nội bộ
  
  // VietQR info
  transferCode    String?       // Mã chuyển khoản (nội dung CK)
  paidAt          DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  address             Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  voucher             Voucher?              @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  subscription        Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]
  referralRecords     ReferralRecord[]

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  variantId     String?  // null nếu variant bị xóa
  
  // Snapshot thông tin lúc mua (QUAN TRỌNG: lưu snapshot để tránh thay đổi giá sau)
  productName   String
  variantName   String
  sku           String
  price         Decimal  @db.Decimal(12, 0)  // Giá tại thời điểm mua
  quantity      Int
  image         String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================================
// LOYALTY & REWARDS (THUYNGA Club)
// ============================================================

model LoyaltyTransaction {
  id           String      @id @default(cuid())
  userId       String
  orderId      String?
  points       Int         // Dương = Cộng điểm, Âm = Trừ điểm
  type         LoyaltyType
  description  String
  balanceAfter Int         // Số dư điểm sau khi thực hiện giao dịch
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int          // 1-5
  content   String?      @db.Text
  images    String[]     // Array of image URLs
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])  // Mỗi user review 1 lần / sản phẩm
  @@index([productId])
  @@map("reviews")
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text  // Rich text HTML
  coverImage  String?
  category    String    @default("Cẩm nang sức khỏe")
  authorName  String    @default("Dược sĩ Thu Nga")
  readingTime Int       @default(5)
  viewCount   Int       @default(0)
  isFeatured  Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("blog_posts")
}

// ============================================================
// SITE SETTINGS (Admin tự sửa logo, banner, footer, SEO...)
// Lưu dạng key-value JSON
// ============================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique  // "homepage_banner", "footer_content", "site_logo"...
  value     Json                // Flexible JSON value
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ============================================================
// MEDIA LIBRARY (Kho ảnh Admin)
// ============================================================

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int      // bytes
  width     Int?
  height    Int?
  altText   String?
  createdAt DateTime @default(now())

  @@map("media")
}

// ============================================================
// IN-APP NOTIFICATIONS (Trung tâm thông báo & chuông báo)
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?          // Đường dẫn khi nhấp vào thông báo
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================
// REFERRAL & AFFILIATE PROGRAM (Mời Bạn Nhận Quà)
// ============================================================

model ReferralRecord {
  id                    String         @id @default(cuid())
  referrerId            String         // Người giới thiệu (chủ link)
  refereeId             String         @unique // Người được giới thiệu (bạn bè)
  orderId               String?        // Đơn hàng đầu tiên đủ điều kiện nhận thưởng
  status                ReferralStatus @default(PENDING)
  referrerRewardPoints  Int            @default(500) // Điểm thưởng cho người giới thiệu
  refereeVoucherCode    String?        // Mã voucher chào mừng tặng bạn mới
  rewardedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  referrer User   @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([status])
  @@map("referral_records")
}

// ============================================================
// SUBSCRIBE & SAVE / AUTO-SHIP (Giao Hàng Định Kỳ Tiết Kiệm)
// ============================================================

model Subscription {
  id                    String                @id @default(cuid())
  subscriptionNumber    String                @unique // SUB-2026-XXXX
  userId                String
  frequency             SubscriptionFrequency @default(EVERY_1_MONTH)
  status                SubscriptionStatus    @default(ACTIVE)
  discountPercent       Int                   @default(10) // Mặc định giảm 10% trọn đời
  
  startDate             DateTime              @default(now())
  nextDeliveryDate      DateTime              // Ngày dự kiến giao kỳ tiếp theo
  lastDeliveryDate      DateTime?             // Ngày giao kỳ gần nhất
  totalCyclesDelivered  Int                   @default(0)  // Số kỳ đã giao thành công

  // Thông tin nhận hàng mặc định cho gói định kỳ
  recipientName         String
  recipientPhone        String
  shippingAddress       String
  paymentMethod         PaymentMethod         @default(COD)
  note                  String?               @db.Text

  pausedAt              DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 SubscriptionItem[]
  orders                Order[]

  @@index([userId])
  @@index([status])
  @@index([nextDeliveryDate])
  @@map("subscriptions")
}

model SubscriptionItem {
  id              String        @id @default(cuid())
  subscriptionId  String
  variantId       String?       // null nếu biến thể bị gỡ
  productName     String
  variantName     String
  sku             String
  originalPrice   Decimal       @db.Decimal(12, 0) // Giá gốc niêm yết
  price           Decimal       @db.Decimal(12, 0) // Giá sau giảm 10% định kỳ
  quantity        Int           @default(1)
  image           String?

  // Relations
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_items")
}
